class Solution
{
public:
    void dfs(int r,int c,int &baseR, int &baseC,vector<vector<int>> &vis,vector<pair<int,int>> &shape,vector<vector<int>> &grid){
        int N = grid[0].size();
        int M = grid.size();//row
        int nr= r-baseR;
        int nc = c-baseC;
        shape.push_back({nr,nc});
        int dr[] = {-1,1,0,0};
        int dc[] = {0,0,-1,1};
        for(int k = 0;k<4;k++){
            int newr = dr[k]+r;
            int newc = dc[k]+c;
            if(newr>=0 && newr<M && newc>=0 && newc<N){
                if(grid[newr][newc]==1 && vis[newr][newc]==0){
                    vis[newr][newc] = 1;
                    dfs(newr,newc,baseR,baseC,vis,shape,grid);
                }
            }
        }
    }
    int countDistinctIslands(vector<vector<int>> &grid){
        int N = grid[0].size();
        int M = grid.size();//row

        vector<vector<int>> vis(M,vector<int> (N,0));
        set<vector<pair<int,int>>> st;

        for(int i = 0;i<M;i++){
            for(int j = 0;j<N;j++){
                if(grid[i][j]==1 && vis[i][j]==0){
                    vis[i][j] = 1;
                    int  baseR = i;
                    int  baseC = j;
                     vector<pair<int,int>> shape;

                    dfs(i,j,baseR,baseC,vis,shape,grid);
                    st.insert(shape);

                }

            }
        }
        return st.size();
        
    }
};
