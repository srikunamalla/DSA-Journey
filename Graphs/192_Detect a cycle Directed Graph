class Solution{
public:
    bool dfs(int node,vector<int> &vis,vector<int> &pathVis,vector<int> adj[]){
        vis[node] = 1;
        pathVis[node] = 1;
        for(auto neigh:adj[node]){
            if(vis[neigh]==0){
                 if(dfs(neigh,vis,pathVis,adj)){
                    return true;}
            }
            if(vis[neigh]==1 && pathVis[neigh]==1){
                return true;
            }
        }
        pathVis[node] = 0;
        return false;
    }
    bool isCyclic(int N, vector<int> adj[]) {
        vector<int> vis(N,0);
        vector<int> pathVis(N,0);
        for(int i = 0;i<N;i++){
            if(vis[i]==0){
                if(dfs(i,vis,pathVis,adj)){
                return true;}
            }
           
        }
        return false;
    }
};
