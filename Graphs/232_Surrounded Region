class Solution{
public:
    vector<vector<char>> fill(vector<vector<char>> mat) {
       queue<pair<int,int>> q;
       int N = mat[0].size(); //col
       int M = mat.size();  //row
       vector<vector<char>> vis(M,vector<char>(N,0));
       for(int i = 0;i<M;i++){
            for(int j = 0;j<N;j++){
                if(mat[i][j]=='O'&& ( i==0 ||i ==M-1|| j==0 ||j==N-1)){
                    vis[i][j] = 1;
                    q.push({i,j});
                }
            }
       }
       while(!q.empty()){
            auto [r,c] = q.front();
             q.pop();
             int dr[] = {-1,1,0,0};
            int dc[] = {0,0,-1,1};
            for(int k = 0;k<4;k++){
                int nr = dr[k]+r;
                int nc = dc[k]+c;
                if(nr>=0 && nr<M && nc>=0 && nc<N){
                    if(mat[nr][nc]=='O' && vis[nr][nc]==0){
                        vis[nr][nc] = 1;
                        q.push({nr,nc});
                    }
                    
                }
            }
       }
       for(int i = 0;i<M;i++){
        for(int j = 0;j<N;j++){
            if(mat[i][j]=='O' && vis[i][j]==0){
                 mat[i][j] = 'X';
            }
        }
       }
       return mat;
    }      
};
