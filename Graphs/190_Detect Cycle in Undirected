class Solution{
public:
    bool dfs(int node,vector<int>& vis,int parent,vector<int> adj[]){
        vis[node]  = 1;
        for(auto neig: adj[node]){
            if(vis[neig] == 0){
                if (dfs(neig,vis,node,adj)){
                    return true;
                }
            }
            else if(neig != parent) {return true ;}
        }
        return false;
    }
    bool isCycle(int V, vector<int> adj[]) {
        vector<int> vis(V,0);
        for(int i=0;i<V;i++){
            if(vis[i]==0){
                vis[i] = 1;
                if(dfs(i,vis,-1,adj)){
                    return true;
                }
                
            }
        }
        return false;
        
    }
};
